# ==============================================================================
# ORBI-SYNC Root Git Ignore Rules
# ==============================================================================

# Environment files and credentials
.env
.env.local
.env.*.local
*.key
*.pem
!.env.example
!MEMBER 4/.env.example
!MEMBER 4/.env.test.example
!member2/.env.example
!frontend/.env.example

# Python virtual environments & bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node.js & Next.js build artifacts
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

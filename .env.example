# ==============================================================================
# ORBI-SYNC Master Environment Variables Template
# Copy this file to .env and configure your production values.
# IMPORTANT: Never commit your .env file with secrets to version control.
# ==============================================================================

# Deployment Environment: development | staging | production
ENVIRONMENT=production

# Supabase Project Connection Details (PostgreSQL catalog and audit storage)
# Required for live database workflows. If empty, the system runs in safe offline/synthetic mode.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# API Authentication Keys
# Used for server-to-server role authorization.
ADMIN_API_KEY=your-production-admin-api-key
OPERATOR_API_KEY=your-production-operator-api-key
DIAGNOSTIC_API_KEY=your-production-diagnostic-api-key

# Backend CORS Configuration
# Comma-separated list of allowed origins that can make requests to the API Gateway.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.orbi-sync.com

# Frontend Public API URL (accessible from client browsers)
NEXT_PUBLIC_API_URL=http://localhost:8000

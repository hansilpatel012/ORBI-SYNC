# ==============================================================================
# ORBI-SYNC Backend Environment Variables Template
# Copy this file to .env and insert your real credentials.
# IMPORTANT: Never commit your .env file to version control.
# ==============================================================================

# Supabase Project Connection Details
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Deployment Environment: development | staging | production
ENVIRONMENT=development

# Diagnostic Endpoint Security (Recommended for staging & required for production)
# When set, requests to /health/database must supply the header:
# X-Diagnostic-Key: <your-key>
DIAGNOSTIC_API_KEY=

# Backend API Keys for Role-Based Authorization
# Used for testing or server-to-server operations.
# Clients connecting with Bearer <ADMIN_API_KEY> receive the 'admin' role.
# Clients connecting with Bearer <OPERATOR_API_KEY> receive the 'operator' role.
# Alternatively, valid Supabase Auth JWT tokens can be supplied in the Bearer header.
ADMIN_API_KEY=dev-admin-secret-key-12345
OPERATOR_API_KEY=dev-operator-secret-key-12345

# CORS Configuration for Frontend Development
# Comma-separated list of allowed origins (e.g. React/Vite/Next.js/Streamlit dashboards)
# Default includes localhost on ports 3000, 5173, 8000, 8080, 8501
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173
# Optional regex matching loopback development hosts
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

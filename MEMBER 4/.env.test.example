# ==============================================================================
# ORBI-SYNC Isolated Test Environment Configuration Template (.env.test)
# ==============================================================================
# Copy this file to .env.test and populate with credentials for a DEDICATED
# TEST / STAGING Supabase project.
#
# IMPORTANT SAFETY RULES:
# 1. NEVER point integration tests to your production Supabase database.
# 2. All live write tests create records prefixed with '[TEST-ORBI-SYNC-EPHEMERAL]'
#    and clean them up automatically upon test completion.
# 3. Live database execution is strictly disabled unless you explicitly set
#    ALLOW_LIVE_DB_TESTS=true and ALLOW_LIVE_WRITE_TESTS=true below.
# ==============================================================================

# Supabase Project Connection Details (Test Project Only)
SUPABASE_URL=https://your-test-project-id.supabase.co
SUPABASE_SECRET_KEY=your-test-service-role-secret-key

# Alternatively pass TEST_SUPABASE_URL / TEST_SUPABASE_SECRET_KEY
TEST_SUPABASE_URL=
TEST_SUPABASE_SECRET_KEY=

# Environment Identifier
ENVIRONMENT=testing

# API Keys for Authenticated Write Operations
ADMIN_API_KEY=test-admin-secret-key-12345
OPERATOR_API_KEY=test-operator-secret-key-12345
DIAGNOSTIC_API_KEY=test-diagnostic-key-12345

# Explicit Live Test Authorization Gates
# Keep set to 'false' until you explicitly approve live execution against this test DB
ALLOW_LIVE_DB_TESTS=false
ALLOW_LIVE_WRITE_TESTS=false
